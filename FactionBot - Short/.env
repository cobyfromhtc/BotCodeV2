# ─────────────────────────────────────────────────────────────────────────────
# FACTIONBOT TOKENS — pick ONE option (full details in tokens.txt)
# ─────────────────────────────────────────────────────────────────────────────
#
# OPTION A — ONE bot that does everything:
#   BOT_TOKEN=your-token-here
#   run:  python PythonFiles/Bot.py
#
# OPTION B — the 3 standard bots (any subset; blank = doesn't run):
#   ModBot_Token=your-moderation-bot-token
#   TicketBot_Token=your-ticket-bot-token
#   UtilityBot_Token=your-utility-bot-token
#   run:  python PythonFiles/RunBots.py
#
# OPTION C — add MORE bots (any name), two lines each:
#   FunBot_Token=your-token
#   FunBot_Cmds=poll,giveaway,endgiveaway        <- commands MOVED to FunBot
#   run:  python PythonFiles/RunBots.py          <- finds them automatically
#
# You can also move commands between standard bots:
#   ModBot_Cmds=poll,serverinfo
#
# Rules: one token per line (extra tokens after a comma are ignored);
# custom names = letters/numbers only; unknown command names are warned.
# ─────────────────────────────────────────────────────────────────────────────

BOT_TOKEN=BOT_TOKEN_HERE

# ModBot_Token=YOUR_MODERATION_BOT_TOKEN_HERE
# TicketBot_Token=YOUR_TICKET_BOT_TOKEN_HERE
# UtilityBot_Token=YOUR_UTILITY_BOT_TOKEN_HERE

# FunBot_Token=YOUR_TOKEN_HERE
# FunBot_Cmds=poll,giveaway,endgiveaway
