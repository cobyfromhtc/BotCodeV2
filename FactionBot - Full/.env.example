# ─────────────────────────────────────────────────────────────────────────────
# FactionBot — Full edition • environment template
#
# 1. Copy this file to `.env` (same folder):
#        cp .env.example .env
# 2. Paste your bot token from the Discord Developer Portal:
#        https://discord.com/developers/applications → your app → Bot →
#        Reset Token
#
# Keep `.env` secret — anyone with the token controls the bot.
# `.env` is git-ignored; this template is the committed reference.
#
# Required Privileged Gateway Intents (Developer Portal → Bot):
#   • Server Members   • Message Content   • Presence
# ─────────────────────────────────────────────────────────────────────────────

BOT_TOKEN=YOUR_BOT_TOKEN_HERE
